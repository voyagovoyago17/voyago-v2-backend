# --- SERVEUR & RÉSEAU ---
PORT=3333
APP_BASE_URL=http://localhost:3333

# --- BASES DE DONNÉES MULTI-TENANT (MongoDB Atlas ou Local) ---
MONGO_URI_GLOBAL=mongodb+srv://user:pass@cluster0.x0soqqd.mongodb.net/voyago_global?retryWrites=true&w=majority
MONGO_URI_TENANT=mongodb+srv://user:pass@cluster0.x0soqqd.mongodb.net/voyago_tenants?retryWrites=true&w=majority
# Fallback local :
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=voyago_db

# --- AUTHENTIFICATION & SÉCURITÉ ---
JWT_SECRET=dev_secret_key_change_in_prod
GOOGLE_CLIENT_ID=placeholder_google_id

# --- MOTEURS IA (Génération d'Itinéraires & POIs) ---
# Moteur principal : gemini (défaut, gratuit) ou claude (clé API Console payante requise)
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...

# --- STOCKAGE MÉDIAS (UploadThing) ---
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=...

# --- EMAILS TRANSACTIONNELS (Resend) ---
RESEND_API_KEY=re_...
# Expéditeur des e-mails (domaine à vérifier dans Resend)
MAIL_FROM=Voyagooo <noreply@voyagooo.com>

# Notifications push (Firebase Cloud Messaging)
# Compte de service Firebase : JSON encodé en base64 (recommandé, une seule ligne)
#   base64 -w0 voyagooo-firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT=
# ...ou chemin du fichier JSON sur le serveur (alternative)
# FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/voyago/secrets/firebase-adminsdk.json

# --- PAIEMENTS & ABONNEMENTS (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Travelpayouts : vrais prix des vols (Aviasales Data API) et liens affiliés
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# ID du projet Travelpayouts (liens partenaires Booking.com, GetYourGuide…)
TRAVELPAYOUTS_TRS=
# Identifiant affilié Booking.com direct (facultatif)
BOOKING_AFFILIATE_ID=
